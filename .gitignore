# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/
next.user-config.*

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
.vercel

# Compact proving/verifier keys (~39 MB, regenerated by `pnpm compact`).
# The TypeScript bindings and ZKIR under contracts/src/managed ARE committed so
# the app and the test suite run without installing the Compact toolchain.
contracts/src/managed/*/keys/

# Deployer wallet seeds. Never commit these.
.secrets/

# Encrypted private-state / signing-key stores written by the deploy script.
verihealth-private-state/
verihealth-signing-keys/

# deployments/ IS committed — contract addresses are public and the app needs
# them to find a deployed contract.

# Bundled output of the deploy script (regenerated by pnpm deploy:contract).
.deploy-build/

# ZK assets copied into the public dir by `pnpm zk:assets` (~38 MB, build output).
public/zk/

# Node-side LevelDB private-state store written by the deploy script, and its
# run log. Both contain deploy-time state, not source.
midnight-level-db/
.deploy-run.log
.claude/
__tests__/
HANDOFF.md