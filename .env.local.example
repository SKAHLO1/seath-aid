# SPDX-License-Identifier: Apache-2.0
#
# Supabase is OPTIONAL. Leave these unset and the demo runs end to end against
# an in-memory proof log — judges do not need a database to evaluate the project.
#
# Set them to switch to the issuance flow: issuers sign in on /issuer and issue
# credentials to a patient's wallet; patients import them on /dashboard; proofs
# and revocations persist in Postgres with Row-Level Security applied.
#
# The project also needs (see README, "Optional: Supabase"):
#   - migrations 0001–0004 run in order in the SQL Editor
#   - Anonymous sign-ins enabled (patients) and Email enabled (issuers)
#   - http://localhost:3000/issuer (and your deployed /issuer) in Redirect URLs
#   - issuer accounts linked once by an administrator in the SQL Editor
#
# Use the PUBLISHABLE key (Project Settings → API Keys, starts `sb_publishable_`).
# Never put a SECRET key (`sb_secret_`) or a legacy service_role key here: they
# bypass RLS, and anything NEXT_PUBLIC_ is shipped to every browser. The app
# refuses to start with one.
#
# Legacy projects: NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback, but
# Supabase is deprecating anon / service_role keys by the end of 2026.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Contract deployment (pnpm deploy:contract)
#
# Only needed to put the contract on chain. The DApp itself does not read any
# of these, and NONE of them may ever be prefixed NEXT_PUBLIC_ — that would
# ship a signing seed to the browser.
# ---------------------------------------------------------------------------

# undeployed | preview | preprod | mainnet. Defaults to preprod.
MIDNIGHT_NETWORK=preprod

# The proof server must be local: it sees your private witness data.
#   docker run -d -p 6300:6300 midnightntwrk/proof-server:8.1.0 \
#     midnight-proof-server -v
MIDNIGHT_PROOF_SERVER=http://localhost:6300

# Deployer wallet seed, 128 hex characters (64 bytes).
#
# Generate the wallet MNEMONIC-FIRST so the same wallet can be imported into
# Lace (needed for the 'Generate tDUST' registration step):
#
#   node scripts/new-deploy-wallet.mjs
#
# That writes .secrets/deployer.mnemonic (24 BIP-39 words) and
# .secrets/deployer.seed (the standard mnemonicToSeed output, 128 hex chars).
#
# Do NOT use `openssl rand -hex 32`. It produces a valid 64-hex seed that the
# SDK accepts, but it has NO mnemonic, so it can never be imported into Lace.
# And converting it with bip39 entropyToMnemonic derives a DIFFERENT wallet.
#
# Prefer the FILE form so the secret never lands in shell history or the
# process listing. Keep it out of git.
MIDNIGHT_WALLET_SEED_FILE=./.secrets/deployer.seed
# MIDNIGHT_WALLET_SEED=

# Encrypts the on-disk private state store. 16+ characters.
MIDNIGHT_PRIVATE_STATE_PASSWORD=

# ---------------------------------------------------------------------------
# On-chain mode (optional)
#
# Leave NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS unset and the app runs the Wave 1
# local demo: real compiled circuits, in-memory ledger, no wallet required.
#
# Set it to the contractAddress from deployments/<network>.json and the app
# talks to the deployed contract instead. That path additionally needs the ZK
# assets reachable over HTTP (`pnpm zk:assets` writes them to public/zk) and a
# proof server the USER controls — the wallet reports its own, and we never
# fall back to a remote host.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=
NEXT_PUBLIC_ZK_CONFIG_BASE=/zk

# Which injected Midnight wallet to connect to when several are installed.
# Unset = 1AM first, then Lace, then whichever wallet injected first.
# Known values: com.midnight.1am (1AM). Lace's rdns contains "lace".
# NEXT_PUBLIC_PREFERRED_WALLET_RDNS=com.midnight.1am
